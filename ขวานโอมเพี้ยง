-- สร้าง UICorner สีรุ้งหมุน
local function AddRainbowBorder(parent, thickness)
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 8)
    corner.Parent = parent

    local border = Instance.new("UIStroke")
    border.Thickness = thickness
    border.LineJoinMode = Enum.LineJoinMode.Round
    border.Transparency = 0
    border.Parent = parent

    -- วนสีรุ้งไปเรื่อยๆ
    task.spawn(function()
        local index = 1
        while parent:IsDescendantOf(game) do
            local nextIndex = index % #RainbowColors + 1
            TweenService:Create(border, TweenInfo.new(0.8, Enum.EasingStyle.Linear), {Color = RainbowColors[nextIndex]}):Play()
            index = nextIndex
            task.wait(0.8)
        end
    end)

    return corner, border
end

