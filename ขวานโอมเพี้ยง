-- ======================
-- 💡 โหมด 1: ลบความมืด
-- ======================
local function SetDarkness(On)
    if On then
        Lighting.Brightness = 3
        Lighting.GlobalShadows = false
        Lighting.Ambient = Color3.fromRGB(200, 200, 200)
        Lighting.OutdoorAmbient = Color3.fromRGB(200, 200, 200)
        Lighting.FogEnd = 100000
        Lighting.FogStart = 0
        Lighting.ColorShiftTop = Color3.fromRGB(255, 255, 255)
        Lighting.ColorShiftBottom = Color3.fromRGB(255, 255, 255)
    else
        Lighting.Brightness = 2
        Lighting.GlobalShadows = true
        Lighting.Ambient = Color3.fromRGB(140, 140, 140)
        Lighting.OutdoorAmbient = Color3.fromRGB(128, 128, 128)
        Lighting.FogEnd = 10000
    end
end

task.spawn(function()
    while task.wait(0.5) do
        if NoDark then
            Lighting.Brightness = math.max(Lighting.Brightness, 2.5)
            Lighting.GlobalShadows = false
        end
    end
end)

-- ======================
-- 🏃 โหมด 2: ปรับความเร็ว
-- ======================
local function UpdateSpeed()
    if Humanoid then Humanoid.WalkSpeed = WalkSpeed end
end

local function SetupCharacter(c)
    if not c then return end
    Character = c
    Humanoid = Character:WaitForChild("Humanoid")
    Humanoid.WalkSpeed = WalkSpeed
end

SetupCharacter(plr.Character or plr.CharacterAdded:Wait())
plr.CharacterAdded:Connect(SetupCharacter)

-- ======================
-- 🎨 โหมด 3: ดินน้ำมัน
-- ======================
local function SetOilPaint(On)
    if On then
        Lighting.Brightness = 2.2
        Lighting.GlobalShadows = true
        Lighting.ShadowSoftness = 0.5
        Lighting.Ambient = Color3.fromRGB(180, 160, 140)
        Lighting.OutdoorAmbient = Color3.fromRGB(200, 180, 160)
        Lighting.FogEnd = 8000
        Lighting.FogColor = Color3.fromRGB(210, 190, 170)
        Lighting.ColorShiftTop = Color3.fromRGB(255, 245, 230)
        Lighting.ColorShiftBottom = Color3.fromRGB(230, 210, 190)
    else
        Lighting.Brightness = 2
        Lighting.GlobalShadows = true
        Lighting.ShadowSoftness = 0.2
        Lighting.Ambient = Color3.fromRGB(140, 140, 140)
        Lighting.OutdoorAmbient = Color3.fromRGB(128, 128, 128)
        Lighting.FogEnd = 100000
        Lighting.FogColor = Color3.fromRGB(200, 220, 255)
        Lighting.ColorShiftTop = Color3.fromRGB(255, 255, 255)
        Lighting.ColorShiftBottom = Color3.fromRGB(255, 255, 255)
    end
end

-- ======================
-- ✨ โหมด 4: กราฟฟิกสูงสุด
-- ======================
local function SetMaxGraphics(On)
    if On then
        Lighting.Brightness = 2.5
        Lighting.GlobalShadows = true
        Lighting.ShadowSoftness = 0.3
        Lighting.Ambient = Color3.fromRGB(150, 160, 180)
        Lighting.OutdoorAmbient = Color3.fromRGB(180, 190, 210)
        Lighting.FogEnd = 150000
        Lighting.FogColor = Color3.fromRGB(200, 220, 255)
        Lighting.ColorShiftTop = Color3.fromRGB(240, 245, 255)
        Lighting.ColorShiftBottom = Color3.fromRGB(220, 230, 245)
    else
        Lighting.Brightness = 2
        Lighting.GlobalShadows = true
        Lighting.ShadowSoftness = 0.2
        Lighting.Ambient = Color3.fromRGB(140, 140, 140)
        Lighting.OutdoorAmbient = Color3.fromRGB(128, 128, 128)
        Lighting.FogEnd = 100000
        Lighting.FogColor = Color3.fromRGB(200, 220, 255)
        Lighting.ColorShiftTop = Color3.fromRGB(255, 255, 255)
        Lighting.ColorShiftBottom = Color3.fromRGB(255, 255, 255)
    end
end

