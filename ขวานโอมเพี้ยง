    NoDark = false, Fly = false, NoClip = false,
    God = false, NoDeath = false, OneHit = false,
    Nuke = false, ItemFind = false, LowGraph = false
}
local Values = {Damage=100, NukeRange=15, WalkSpeed=16, FlySpeed=35}
local Refs = {BodyVel=nil, Humanoid=nil, HRP=nil, Char=nil, ItemMarkers={}}
