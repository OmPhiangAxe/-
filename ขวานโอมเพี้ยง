local G=Instance.new("ScreenGui")G.Name="SP"G.ResetOnSpawn=false G.IgnoreGuiInset=true G.ZIndexBehavior=Enum.ZIndexBehavior.Sibling G.Parent=gp()

local function mkP(sz,pos,par,col)
    local f=Instance.new("Frame")
    f.Size=sz f.Position=pos f.BackgroundColor3=col f.Parent=par
    f.BorderSizePixel=0
    Instance.new("UICorner",f).CornerRadius=UDim.new(0,16)
    local shadow=Instance.new("UIStroke")
    shadow.Thickness=1 shadow.Color=Color3.fromRGB(255,255,255) shadow.Transparency=0.92 shadow.Parent=f
    return f
end

local function mkB(tx,sz,pos,par,bgCol,hovCol,tCol)
    local b=Instance.new("TextButton")
    b.Size=sz b.Position=pos b.Text=tx b.BackgroundColor3=bgCol
    b.TextColor3=tCol or Color3.new(1,1,1)
    b.Font=Enum.Font.GothamBold b.TextSize=14 b.AutoLocalize=false
    b.BorderSizePixel=0 b.ClipsDescendants=true b.Parent=par
    Instance.new("UICorner",b).CornerRadius=UDim.new(0,10)
    local hover=hovCol or Color3.fromRGB(70,70,90)
    b.MouseEnter:Connect(function()b.BackgroundColor3=hover end)
    b.MouseLeave:Connect(function()b.BackgroundColor3=bgCol end)
    return b
end

