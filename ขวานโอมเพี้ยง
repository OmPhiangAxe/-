-- ========== คืนค่าแสงเดิม ==========
local function restoreLight()
    Lighting.Brightness = Orig.Brightness
    Lighting.ClockTime = Orig.ClockTime
    Lighting.GlobalShadows = Orig.GlobalShadows
    Lighting.ShadowSoftness = Orig.ShadowSoftness
    Lighting.Ambient = Orig.Ambient
    Lighting.OutdoorAmbient = Orig.OutdoorAmbient
    Lighting.FogEnd = Orig.FogEnd
    Lighting.FogStart = Orig.FogStart
    Lighting.FogColor = Orig.FogColor
    Lighting.ExposureCompensation = Orig.ExposureCompensation
    Lighting.EnvironmentSpecularScale = Orig.Specular
    Lighting.EnvironmentDiffuseScale = Orig.Diffuse
    for _,e in pairs(MyEffects) do pcall(function() e:Destroy() end) end
    MyEffects = {}
end

-- ========== ลบสีแดง/เอฟเฟกต์ ==========
local function clearRedEffects()
    for _,e in pairs(Lighting:GetChildren()) do
        if e:IsA("PostEffect") or e:IsA("Atmosphere") then
            pcall(function() e:Destroy() end)
        end
    end
    local cam = workspace.CurrentCamera
    if cam then
        for _,e in pairs(cam:GetChildren()) do
            if e:IsA("PostEffect") or e:IsA("Atmosphere") then
                pcall(function() e:Destroy() end)
            end
        end
    end
end

-- ========== 1. ลบมืด ==========
local function setDark(on)
    if on then
        clearRedEffects()
        Lighting.Brightness = 10
        Lighting.ClockTime = 12
        Lighting.GlobalShadows = false
        Lighting.Ambient = Color3.fromRGB(255,255,255)
        Lighting.OutdoorAmbient = Color3.fromRGB(255,255,255)
        Lighting.FogEnd = 1000000
        Lighting.FogColor = Color3.fromRGB(255,255,255)
        Lighting.ExposureCompensation = 2
    else
        restoreLight()
    end
end

-- ========== 2. กราฟฟิกสูงสุด ลบสีแดง ==========
local function setMaxGfx(on)
    if on then
        clearRedEffects()
        Lighting.Brightness = 3
        Lighting.ClockTime = 14.5
        Lighting.GlobalShadows = true
        Lighting.ShadowSoftness = 0.2
        Lighting.Ambient = Color3.fromRGB(170,180,200)
        Lighting.OutdoorAmbient = Color3.fromRGB(200,210,230)
        Lighting.FogEnd = 1000000
        Lighting.FogColor = Color3.fromRGB(220,230,255)
        Lighting.ColorShiftTop = Color3.fromRGB(255,255,255)
        Lighting.ColorShiftBottom = Color3.fromRGB(255,255,255)
        Lighting.ExposureCompensation = 2
        Lighting.EnvironmentSpecularScale = 1
        Lighting.EnvironmentDiffuseScale = 1
        for _,v in pairs(workspace:GetDescendants()) do
            if v:IsA("BasePart") then v.CastShadow = true end
        end
        local bloom = Instance.new("BloomEffect")
        bloom.Intensity = 10; bloom.Size = 100; bloom.Threshold = 0.8
        bloom.Parent = Lighting; table.insert(MyEffects, bloom)
        local sun = Instance.new("SunRaysEffect")
        sun.Intensity = 1; sun.Spread = 1
        sun.Parent = Lighting; table.insert(MyEffects, sun)
        local cc = Instance.new("ColorCorrectionEffect")
        cc.Brightness = 0.1; cc.Contrast = 1; cc.Saturation = 1
        cc.TintColor = Color3.fromRGB(255,255,255)
        cc.Parent = Lighting; table.insert(MyEffects, cc)
        local atm = Instance.new("Atmosphere")
        atm.Density = 0.3; atm.Offset = 0.25
        atm.Color = Color3.fromRGB(199,215,240)
        atm.Decay = Color3.fromRGB(110,140,180)
        atm.Glare = 1; atm.Haze = 10
        atm.Parent = Lighting; table.insert(MyEffects, atm)
    else
        restoreLight()
    end
end

-- ========== 6. ป้องกันโดนเตะออก ==========
local function setAntiKick(on)
    if on then
        pcall(function()
            if not OriginalKick then OriginalKick = plr.Kick end
            plr.Kick = function() end
        end)
        pcall(function()
            if not OriginalMessage then OriginalMessage = plr.Message end
            plr.Message = function() end
        end)
        print("[🛡️] เปิดป้องกันเตะออก")
    else
        pcall(function()
            if OriginalKick then plr.Kick = OriginalKick end
            if OriginalMessage then plr.Message = OriginalMessage end
        end)
        print("[🛡️] ปิดป้องกันเตะออก")
    end
end

-- ========== 7. ดินน้ำมัน/ลื่นขึ้น ==========
local function setOilPaint(on)
    if on then
        clearRedEffects()
        Lighting.Brightness = 2.5
        Lighting.ClockTime = 16
        Lighting.ShadowSoftness = 0.8
        Lighting.Ambient = Color3.fromRGB(200,160,120)
        Lighting.OutdoorAmbient = Color3.fromRGB(220,180,140)
        Lighting.FogEnd = 5000
        Lighting.FogColor = Color3.fromRGB(230,190,150)
        Lighting.ColorShiftTop = Color3.fromRGB(255,235,200)
        Lighting.ColorShiftBottom = Color3.fromRGB(200,160,120)
        Lighting.EnvironmentSpecularScale = 0.2
        Lighting.ExposureCompensation = 0.3
        local blur = Instance.new("BlurEffect")
        blur.Size = 4
        blur.Parent = Lighting
        table.insert(MyEffects, blur)
        local cc = Instance.new("ColorCorrectionEffect")
        cc.Brightness = 0.05
        cc.Contrast = -0.15
        cc.Saturation = 0.4
        cc.TintColor = Color3.fromRGB(255,230,190)
        cc.Parent = Lighting
        table.insert(MyEffects, cc)
        if Humanoid then Humanoid.BreakJointsOnDeath = false end
        print("[🎨] เปิดโหมดดินน้ำมัน ลื่นขึ้น!")
    else
        restoreLight()
        print("[🎨] ปิดโหมดดินน้ำมัน")
    end
end

-- ========== 3. กระโดดไม่จำกัด ==========
local function doJump()
    if not InfiniteJump or not Humanoid or not HRP then return end
    local now = tick()
    if now - LastJump < 0.15 then return end
    LastJump = now
    Humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
    wait(0.05)
    if HRP then
        local v = HRP.Velocity
        HRP.Velocity = Vector3.new(v.X, 55, v.Z)
    end
end
UserInputService.JumpRequest:Connect(doJump)

-- ========== 4. อมตะ ==========
local function setGod(on)
    if on then
        if Humanoid then
            Humanoid.MaxHealth = math.huge
            Humanoid.Health = math.huge
        end
        if FF then pcall(function() FF:Destroy() end) end
        FF = Instance.new("ForceField")
        FF.Parent = plr.Character
    else
        if FF then pcall(function() FF:Destroy() end); FF = nil end
        if Humanoid then
            Humanoid.MaxHealth = 100
            Humanoid.Health = 100
        end
    end
end
task.spawn(function()
    while task.wait(0.3) do
        if GodMode and Humanoid then
            Humanoid.Health = math.huge
            Humanoid.MaxHealth = math.huge
            if not FF or not FF.Parent then
                FF = Instance.new("ForceField")
                FF.Parent = plr.Character
            end
        end
    end
end)

