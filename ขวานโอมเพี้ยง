-- ===== บันทึกค่าเดิม =====
Orig.Lighting = {
    Brightness = Lighting.Brightness, ClockTime = Lighting.ClockTime,
    GlobalShadows = Lighting.GlobalShadows, Fog = Lighting.Fog,
    FogDensity = Lighting.FogDensity
}
Orig.Render = {Quality=settings():GetService("RenderSettings").QualityLevel}

-- ===== ฟังก์ชันพื้นฐาน =====
local function SetupChar(c)
    if not c then return end
    Refs.Char = c
    Refs.Humanoid = c:WaitForChild("Humanoid")
    Refs.HRP = c:WaitForChild("HumanoidRootPart")
    Refs.Humanoid.WalkSpeed = Values.WalkSpeed
    Refs.Humanoid.GravityScale = 1
end
SetupChar(plr.Character)
plr.CharacterAdded:Connect(SetupChar)

-- ===== ฟีเจอร์ต่างๆ =====
local function SetNoDark(on)
    Settings.NoDark = on
    if on then
        Lighting.Brightness = 2
        Lighting.ClockTime = 12
        Lighting.GlobalShadows = false
        Lighting.Ambient = Color3.fromRGB(200,200,200)
        Lighting.OutdoorAmbient = Color3.fromRGB(200,200,200)
    else
        Lighting.Brightness = Orig.Lighting.Brightness
        Lighting.ClockTime = Orig.Lighting.ClockTime
        Lighting.GlobalShadows = Orig.Lighting.GlobalShadows
    end
end

local function SetFly(on)
    Settings.Fly = on
    if not Refs.Humanoid or not Refs.HRP then return end
    if on then
        Refs.Humanoid.GravityScale = 0
        Refs.Humanoid.JumpPower = 0
        task.spawn(function()
            while Settings.Fly and Refs.HRP do
                local camCF = workspace.CurrentCamera.CFrame
                local move = Vector3.new()
                if UIS:IsKeyDown(Enum.KeyCode.W) then move += camCF.LookVector end
                if UIS:IsKeyDown(Enum.KeyCode.S) then move -= camCF.LookVector end
                if UIS:IsKeyDown(Enum.KeyCode.A) then move -= camCF.RightVector end
                if UIS:IsKeyDown(Enum.KeyCode.D) then move += camCF.RightVector end
                if UIS:IsKeyDown(Enum.KeyCode.Space) then move += Vector3.new(0,1,0) end
                if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then move -= Vector3.new(0,1,0) end
                Refs.HRP.Velocity = move.Unit * Values.FlySpeed
                task.wait(0.05)
            end
        end)
    else
        Refs.Humanoid.GravityScale = 1
    end
end

local function SetNoClip(on)
    Settings.NoClip = on
    task.spawn(function()
        while Settings.NoClip and Refs.Char do
            for _, part in pairs(Refs.Char:GetChildren()) do
                if part:IsA("BasePart") then part.CanCollide = false end
            end
            task.wait(0.1)
        end
    end)
end

local function SetLowGraph(on)
    Settings.LowGraph = on
    local RS = settings():GetService("RenderSettings")
    if on then
        RS.QualityLevel = 1
        RS.ShadowMapSize = 64
        RS.MaterialQuality = Enum.MaterialQuality.Low
        RS.AmbientOcclusion = Enum.AmbientOcclusion.Off
        RS.BloomEffect = Enum.BloomEffect.Off
        RS.ColorCorrection = Enum.ColorCorrection.Off
        Lighting.GlobalShadows = false
        Lighting.Fog = false
        for _, v in pairs(workspace:GetDescendants()) do
            if v:IsA("BasePart") then v.CastShadow = false end
        end
    else
        RS.QualityLevel = Orig.Render.Quality
        RS.AmbientOcclusion = Enum.AmbientOcclusion.Auto
        RS.BloomEffect = Enum.BloomEffect.Auto
        RS.ColorCorrection = Enum.ColorCorrection.Auto
        Lighting.GlobalShadows = Orig.Lighting.GlobalShadows
        Lighting.Fog = Orig.Lighting.Fog
    end
end

