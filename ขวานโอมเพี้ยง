local P,R,U,p=game:GetService("Players"),game:GetService("RunService"),game:GetService("UserInputService"),game.Players.LocalPlayer
local awO=false
local spdMult=0
local lastPos=nil
local baseSpd=16
local origWS=16

-- ==============================
-- 🚀 Speed System
-- ==============================
local speedLevels = {0, 5, 10, 15, 20, 30, 40, 50}
local speedIndex = 1

local function gp()local a,b=pcall(function()return gethui()end)if a and b then return b end return game:GetService("CoreGui")or p:WaitForChild("PlayerGui")end
local function rp()local p2=RaycastParams.new()p2.FilterDescendantsInstances={p.Character}p2.FilterType=Enum.RaycastFilterType.Exclude p2.IgnoreWater=true return p2 end
local function groundAt(pos)return workspace:Raycast(pos,Vector3.new(0,-8,0),rp())~=nil end
local function grabBase()pcall(function()local c=p.Character if c then local h=c:FindFirstChildOfClass("Humanoid")if h and h.WalkSpeed>0 and h.WalkSpeed<100 then baseSpd=h.WalkSpeed origWS=baseSpd end end end)end

local function fS()pcall(function()
    local c=p.Character if not c then return end
    local h=c:FindFirstChildOfClass("Humanoid")if not h then return end
    local r=c:FindFirstChild("HumanoidRootPart")if not r then return end
    local curPos=r.Position
    local antiOn=awO or spdMult>0

    if groundAt(curPos)then lastPos=curPos end
    if antiOn and not groundAt(curPos)then
        if r.Velocity.Y<-3 or h:GetState()==Enum.HumanoidStateType.Freefall then
            if lastPos then r.CFrame=CFrame.new(lastPos)r.Velocity=Vector3.new()h.PlatformStand=false end
            return
        end
    end

    if spdMult==0 then return end
    local curSp=baseSpd*spdMult
    h.WalkSpeed=curSp

    if r and h.MoveDirection.Magnitude>0.1 then
        local lv=h.MoveDirection
        if antiOn then
            local nextPos=curPos+lv*math.max(3,curSp*0.05)
            if not groundAt(nextPos)then
                r.Velocity=Vector3.new(0,r.Velocity.Y,0)
                return
            end
        end
        r.AssemblyLinearVelocity=Vector3.new(lv.X*curSp,r.AssemblyLinearVelocity.Y,lv.Z*curSp)
    end
end)end

local function updateSpeedBtn()
    if spdMult==0 then
        X2.Text = "🚀 Speed: Off"
        X2.BackgroundColor3 = Color3.fromRGB(45, 45, 58)
    else
        X2.Text = "🚀 Speed: x"..spdMult
        X2.BackgroundColor3 = Color3.fromRGB(59, 130, 246)
    end
end

local function toggleSpeed()
    if speedIndex == 1 then speedIndex = 2 else speedIndex = 1 end
    spdMult = speedLevels[speedIndex]
    if spdMult > 0 then grabBase() end
    updateSpeedBtn()
end

local function speedUp()
    if speedIndex == 1 then grabBase() end
    if speedIndex < #speedLevels then
        speedIndex += 1
        spdMult = speedLevels[speedIndex]
    end
    updateSpeedBtn()
end

local function speedDown()
    if speedIndex > 1 then
        speedIndex -= 1
        spdMult = speedLevels[speedIndex]
    end
    updateSpeedBtn()
end

-- ==============================
-- 🛡️ Anti-Fall
-- ==============================
local function updateAntiFallBtn()
    if awO then
        AW.Text = "🛡️ Anti-Fall: ON ✅"
        AW.BackgroundColor3 = Color3.fromRGB(59, 130, 246)
    else
        AW.Text = "🛡️ Anti-Fall: Off"
        AW.BackgroundColor3 = Color3.fromRGB(45, 45, 58)
    end
end

